@@ -347,6 +347,9 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+#if SWEET_LAKE
+	*(volatile uint64_t *)(uintptr_t)(SWEET_LAKELOG_PHYS + 16) = 0x21;     /* V=P breadcrumb */
