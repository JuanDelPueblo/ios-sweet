+#endif
 #endif
 
 	/* Ensure TTEs are visible */
@@ -832,10 +941,16 @@ common_start:
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+#if SWEET_LAKE
+	LAKE_CRUMB 0x13
+#endif
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+#if SWEET_LAKE
+	LAKE_CRUMB 0x14
+#endif
 
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
@@ -899,6 +1014,9 @@ common_start:
 	mov	lr, x21
 #endif
 
+#if SWEET_LAKE
+	LAKE_CRUMB 0x15
+#endif
 	// Return to arm_init()
 	ret
 
