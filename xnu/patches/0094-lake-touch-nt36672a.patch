+#else /* SWEET_LAKE */
+/*
+ * lake: the panel's Novatek NT36672A (touch and display in one IC, powered
+ * with the panel) answers at 0x01 on BLSP1 QUP3 I2C (GPIO 10/11); reset is
+ * GPIO 66 (active low), the report line GPIO 67. ABL leaves the QUP3 core
+ * clock off: clock it from XO, mux the pins and drive the QUP as a polled
+ * I2C master (QUP v2 tags, FIFO mode, 400 kHz), as the shim's touch probe
+ * does. Reads only. Edges on the report line latch in the TLMM (raw status,
+ * interrupt not enabled), so idle polling is one register read per tick; a
+ * report is read on a latched edge, while a finger is down, and every
+ * 100 ms regardless.
+ */
+#define LT_GCC_PA               0x00100000u
+#define LT_GCC_SIZE             0x60000u
+#define LT_GCC_AHB_CBCR         0x17004u
+#define LT_GCC_VOTE             0x52004u        /* APCS clock branch enable vote */
+#define LT_GCC_AHB_VOTE         (1u << 17)      /* BLSP1 AHB */
+#define LT_GCC_QUP3_CBCR        0x1d008u
+#define LT_GCC_QUP3_RCGR        0x1d020u        /* CMD; CFG at +4 */
+#define LT_TLMM_PA              0x03900000u     /* TLMM north tile */
+#define LT_TLMM_SIZE            0x44000u
+#define LT_GPIO_CFG(n)          ((uint32_t)(n) * 0x1000u)
+#define LT_GPIO_IO(n)           (LT_GPIO_CFG(n) + 4u)
+#define LT_GPIO_INTR_CFG(n)     (LT_GPIO_CFG(n) + 8u)
+#define LT_GPIO_INTR_STATUS(n)  (LT_GPIO_CFG(n) + 0xcu)
+#define LT_SDA                  10u
+#define LT_SCL                  11u
+#define LT_RESET                66u
+#define LT_IRQ                  67u
+#define LT_FUNC_I2C3            2u
+#define LT_QUP_PA               0x0c177000u     /* blsp_i2c3, qcom,i2c-qup-v2.2.1 */
+#define QUP_CONFIG              0x000u
+#define QUP_STATE               0x004u
+#define QUP_IO_MODE             0x008u
+#define QUP_SW_RESET            0x00cu
+#define QUP_OPERATIONAL         0x018u
+#define QUP_ERROR_FLAGS         0x01cu
+#define QUP_MX_OUTPUT_CNT       0x100u
+#define QUP_OUT_FIFO            0x110u
+#define QUP_MX_WRITE_CNT        0x150u
+#define QUP_MX_INPUT_CNT        0x200u
+#define QUP_MX_READ_CNT         0x208u
+#define QUP_IN_FIFO             0x218u
+#define QUP_I2C_CLK_CTL         0x400u
+#define QUP_I2C_STATUS          0x404u
+#define QUP_I2C_MASTER_GEN      0x408u
+#define QUP_ST_RESET            0u
+#define QUP_ST_RUN              1u
+#define QUP_ST_PAUSE            3u
+#define QUP_ST_VALID            (1u << 2)
+#define QUP_ST_MAST_GEN         (1u << 4)
+#define QUP_CONFIG_I2C          (2u << 8 | 7u)  /* I2C mini core, 8-bit words */
+#define QUP_CONFIG_NO_INPUT     (1u << 7)
+#define QUP_IO_REPACK           (3u << 14)
+#define QUP_DURING_RUN          (1u << 31)
+#define QUP_OP_OUT_SVC          (1u << 8)
+#define QUP_OP_IN_SVC           (1u << 9)
+#define QUP_OP_OUT_DONE         (1u << 10)
+#define QUP_OP_IN_DONE          (1u << 11)
+#define QUP_BUS_ACTIVE          (1u << 8)
+#define QUP_BUS_ERRORS          0x38000fcu
+#define QUP_ERRORS              0x7cu
+#define QUP_CLK_400K            (14u << 16 | 3u << 8 | 28u)     /* from 19.2 MHz */
+#define TAG_START               0x81u
+#define TAG_DATA_WR             0x82u
+#define TAG_DATA_RD_STOP        0x87u
+#define NVT_ADDR                0x01u
+#define NVT_TOUCH               0x00u
+#define NVT_PARAMS              0x78u
+#define NVT_PARAMS_SIZE         15u
+#define NVT_CHIP_NT36672A       0x08u
+#define LT_FINGERS              10u
+
+static struct {
+	vm_offset_t gcc, gpio, qup;
+	bool started;
+	unsigned fingers, in_fifo;
+	uint32_t bus_err, qup_err, active;
+	int x[LT_FINGERS], y[LT_FINGERS];
+} lt;
+static int lt_sleep_chan;
+
+static uint32_t
+lt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+lt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+lt_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&lt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint64_t
+lt_deadline(uint64_t us)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(us * NSEC_PER_USEC, &t);
+	return mach_absolute_time() + t;
+}
+
+/* Busy-wait until (reg & mask) == want: 0, or ETIMEDOUT. */
+static int
+lt_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, uint64_t us)
+{
+	uint64_t end = lt_deadline(us);
+	while ((lt_rd(base, off) & mask) != want) {
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+static int
+lt_qup_state(uint32_t s)
+{
+	if (lt_poll(lt.qup, QUP_STATE, QUP_ST_VALID, QUP_ST_VALID, 1000)) {
+		return ETIMEDOUT;
+	}
+	lt_wr(lt.qup, QUP_STATE, s);
+	return lt_poll(lt.qup, QUP_STATE, QUP_ST_VALID | 3u, QUP_ST_VALID | s, 1000);
+}
+
+/* Bus and QUP errors latch: remember and clear them. */
+static bool
+lt_qup_failed(void)
+{
+	uint32_t bus = lt_rd(lt.qup, QUP_I2C_STATUS) & QUP_BUS_ERRORS;
+	uint32_t qup = lt_rd(lt.qup, QUP_ERROR_FLAGS) & QUP_ERRORS;
+	if (!bus && !qup) {
+		return false;
+	}
+	lt.bus_err = bus;
+	lt.qup_err = qup;
+	lt_wr(lt.qup, QUP_I2C_STATUS, bus);
+	lt_wr(lt.qup, QUP_ERROR_FLAGS, qup);
+	return true;
+}
+
+static int
+lt_qup_wait(uint32_t mask, uint64_t us)
+{
+	uint64_t end = lt_deadline(us);
+	uint32_t op;
+	while (!((op = lt_rd(lt.qup, QUP_OPERATIONAL)) & mask)) {
+		if (lt_qup_failed()) {
+			return EIO;
+		}
+		if (mach_absolute_time() > end) {
+			return ETIMEDOUT;
+		}
+	}
+	lt_wr(lt.qup, QUP_OPERATIONAL, op & (QUP_OP_OUT_SVC | QUP_OP_IN_SVC));
+	return lt_qup_failed() ? EIO : 0;
+}
+
+static void
+lt_fifo_put(const uint8_t *b, unsigned n)
+{
+	for (unsigned i = 0; i < n; i += 4) {
+		uint32_t w = 0;
+		for (unsigned j = 0; j < 4 && i + j < n; j++) {
+			w |= (uint32_t)b[i + j] << (8 * j);
+		}
+		lt_wr(lt.qup, QUP_OUT_FIFO, w);
+	}
+}
+
+/*
+ * Register write, repeated start, n-byte read: Linux i2c-qup's two messages
+ * in FIFO mode. n + 2 (the echoed read tags) must fit the input FIFO.
+ */
+static int
+lt_i2c_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned n)
+{
+	int error;
+
+	if (n == 0 || n + 2 > lt.in_fifo) {
+		return EINVAL;
+	}
+	lt_wr(lt.qup, QUP_SW_RESET, 1);
+	if (lt_poll(lt.qup, QUP_STATE, QUP_ST_VALID | 3u, QUP_ST_VALID | QUP_ST_RESET, 1000)) {
+		return ENXIO;
+	}
+	lt_wr(lt.qup, QUP_CONFIG, QUP_CONFIG_I2C);
+	lt_wr(lt.qup, QUP_I2C_MASTER_GEN, 1);   /* v2 tags */
+	if (lt_poll(lt.qup, QUP_STATE, QUP_ST_MAST_GEN, QUP_ST_MAST_GEN, 1000)) {
+		return ENXIO;
+	}
+	lt_wr(lt.qup, QUP_MX_OUTPUT_CNT, 0);
+	lt_wr(lt.qup, QUP_MX_INPUT_CNT, 0);
+	lt_wr(lt.qup, QUP_IO_MODE, QUP_IO_REPACK);
+
+	const uint8_t wr[5] = { TAG_START, (uint8_t)(addr << 1), TAG_DATA_WR, 1, reg };
+	lt_wr(lt.qup, QUP_MX_WRITE_CNT, sizeof(wr));
+	lt_wr(lt.qup, QUP_CONFIG, QUP_CONFIG_I2C | QUP_CONFIG_NO_INPUT);
+	if (lt_qup_state(QUP_ST_RUN)) {
+		return ENXIO;
+	}
+	lt_wr(lt.qup, QUP_I2C_CLK_CTL, QUP_CLK_400K);
+	if (lt_qup_state(QUP_ST_PAUSE)) {
+		return ENXIO;
+	}
+	lt_fifo_put(wr, sizeof(wr));
+	if (lt_qup_state(QUP_ST_RUN)) {
+		return ENXIO;
+	}
+	if ((error = lt_qup_wait(QUP_OP_OUT_SVC | QUP_OP_OUT_DONE, 20000))) {
+		goto out;
+	}
+	if (lt_qup_state(QUP_ST_PAUSE)) {
+		return ENXIO;
+	}
+
+	const uint8_t rt[4] = { TAG_START, (uint8_t)(addr << 1 | 1), TAG_DATA_RD_STOP, (uint8_t)n };
+	lt_wr(lt.qup, QUP_MX_WRITE_CNT, QUP_DURING_RUN | sizeof(rt));
+	lt_wr(lt.qup, QUP_MX_READ_CNT, QUP_DURING_RUN | (n + 2));
+	lt_wr(lt.qup, QUP_CONFIG, QUP_CONFIG_I2C);
+	lt_fifo_put(rt, sizeof(rt));
+	if (lt_qup_state(QUP_ST_RUN)) {
+		return ENXIO;
+	}
+	if ((error = lt_qup_wait(QUP_OP_IN_DONE, 20000))) {
+		goto out;
+	}
+	for (unsigned got = 0; got < n + 2;) {
+		uint32_t w = lt_rd(lt.qup, QUP_IN_FIFO);
+		for (unsigned j = 0; j < 4 && got < n + 2; j++, got++) {
+			if (got >= 2) {
+				buf[got - 2] = (uint8_t)(w >> (8 * j));
+			}
+		}
+	}
+	if (lt_poll(lt.qup, QUP_I2C_STATUS, QUP_BUS_ACTIVE, 0, 5000)) {
+		error = ETIMEDOUT;
+	}
+out:
+	(void)lt_qup_state(QUP_ST_RESET);
+	return error;
+}
+
+static bool
+lt_clocks(void)
+{
+	lt_wr(lt.gcc, LT_GCC_VOTE, lt_rd(lt.gcc, LT_GCC_VOTE) | LT_GCC_AHB_VOTE);
+	lt_wr(lt.gcc, LT_GCC_QUP3_RCGR + 4, 0);        /* CFG: source XO, no divider */
+	lt_wr(lt.gcc, LT_GCC_QUP3_RCGR, lt_rd(lt.gcc, LT_GCC_QUP3_RCGR) | 1u);
+	(void)lt_poll(lt.gcc, LT_GCC_QUP3_RCGR, 1u, 0, 10000);
+	lt_wr(lt.gcc, LT_GCC_QUP3_CBCR, lt_rd(lt.gcc, LT_GCC_QUP3_CBCR) | 1u);
+	if (lt_poll(lt.gcc, LT_GCC_QUP3_CBCR, 1u << 31, 0, 10000) ||
+	    lt_poll(lt.gcc, LT_GCC_AHB_CBCR, 1u << 31, 0, 10000)) {
+		printf("LAKE TOUCH: QUP3 clocks stay off (qup3 %#x ahb %#x)\n",
+		    lt_rd(lt.gcc, LT_GCC_QUP3_CBCR), lt_rd(lt.gcc, LT_GCC_AHB_CBCR));
+		return false;
+	}
+	return true;
+}
+
+static void
+lt_report(uint32_t mask)
+{
+	for (unsigned id = 0; id < LT_FINGERS; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			sweet_hid_touch((int)id, 1, lt.x[id], lt.y[id]);
+		} else if (lt.active & bit) {
+			sweet_hid_touch((int)id, 0, lt.x[id], lt.y[id]);
+		}
+	}
+	lt.active = mask;
+}
+
+/* One report: 6 bytes per finger record, slot in bits 7:3, 1/2 = down/moved. */
+static int
+lt_poll_report(void)
+{
+	uint8_t ev[6 * LT_FINGERS];
+	int error = lt_i2c_read(NVT_ADDR, NVT_TOUCH, ev, lt.fingers * 6);
+	if (error) {
+		return error;
+	}
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < lt.fingers; i++) {
+		const uint8_t *t = ev + 6 * i;
+		unsigned type = t[0] & 7u, slot = t[0] >> 3;
+		if ((type != 1 && type != 2) || slot < 1 || slot > LT_FINGERS) {
+			continue;
+		}
+		unsigned id = slot - 1;
+		mask |= 1u << id;
+		lt.x[id] = (int)((unsigned)t[1] << 4 | t[3] >> 4);
+		lt.y[id] = (int)((unsigned)t[2] << 4 | (t[3] & 0xfu));
+	}
+	lt_report(mask);
+	return 0;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 5;
+	uint8_t p[NVT_PARAMS_SIZE] = { 0 };
+	(void)arg;
+	(void)result;
+
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	lt_sleep_ms(delay_s * 1000u);
+	lt.gcc = ml_io_map(LT_GCC_PA, LT_GCC_SIZE);
+	lt.gpio = ml_io_map(LT_TLMM_PA, LT_TLMM_SIZE);
+	lt.qup = ml_io_map(LT_QUP_PA, 0x1000);
+	if (!lt.gcc || !lt.gpio || !lt.qup) {
+		printf("LAKE TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	if (!lt_clocks()) {
+		goto out;
+	}
+	/* SDA/SCL: blsp_i2c3, 2 mA, no pull (Linux i2c3_default) */
+	lt_wr(lt.gpio, LT_GPIO_CFG(LT_SDA), LT_FUNC_I2C3 << 2);
+	lt_wr(lt.gpio, LT_GPIO_CFG(LT_SCL), LT_FUNC_I2C3 << 2);
+	lt_wr(lt.qup, QUP_SW_RESET, 1);
+	if (lt_poll(lt.qup, QUP_STATE, QUP_ST_VALID, QUP_ST_VALID, 10000)) {
+		printf("LAKE TOUCH: QUP3 never valid\n");
+		goto out;
+	}
+	uint32_t io = lt_rd(lt.qup, QUP_IO_MODE);
+	static const unsigned blk[4] = { 4, 16, 32, 0 };
+	lt.in_fifo = blk[(io >> 5) & 3u] * (2u << ((io >> 7) & 7u));
+
+	int error = lt_i2c_read(NVT_ADDR, NVT_PARAMS, p, NVT_PARAMS_SIZE);
+	if (error) {
+		/* Out of reset (Linux waits 100 ms before the parameters) */
+		lt_wr(lt.gpio, LT_GPIO_IO(LT_RESET), 2u);
+		lt_wr(lt.gpio, LT_GPIO_CFG(LT_RESET), 1u << 9);
+		lt_sleep_ms(150);
+		error = lt_i2c_read(NVT_ADDR, NVT_PARAMS, p, NVT_PARAMS_SIZE);
+	}
+	if (error) {
+		printf("LAKE TOUCH: no answer at 0x%x (%d, bus %#x qup %#x)\n", NVT_ADDR, error,
+		    lt.bus_err, lt.qup_err);
+		goto out;
+	}
+	unsigned w = (unsigned)p[4] << 8 | p[5], h = (unsigned)p[6] << 8 | p[7], max = p[9];
+	lt.fingers = 5;
+	(void)PE_parse_boot_argn("laketouchfingers", &lt.fingers, sizeof(lt.fingers));
+	if (max && lt.fingers > max) {
+		lt.fingers = max;
+	}
+	if (lt.fingers == 0 || lt.fingers > LT_FINGERS) {
+		lt.fingers = LT_FINGERS;
+	}
+	while (lt.fingers * 6 + 2 > lt.in_fifo) {
+		lt.fingers--;
+	}
+	printf("LAKE TOUCH: Novatek chip %#x %ux%u, %u touches (reading %u), irq type %u, fifo %u\n",
+	    p[14], w, h, max, lt.fingers, p[11], lt.in_fifo);
+	if (p[14] != NVT_CHIP_NT36672A || w != 1080 || h != 2270) {
+		printf("LAKE TOUCH: not lake's NT36672A panel; coordinates may be off\n");
+	}
+	/* Report line: latch both edges in the raw status, interrupt left disabled */
+	lt_wr(lt.gpio, LT_GPIO_INTR_CFG(LT_IRQ), 3u << 5 | 1u << 4 | 3u << 2 | 1u << 1);
+	lt_wr(lt.gpio, LT_GPIO_INTR_STATUS(LT_IRQ), 0);
+
+	unsigned errors = 0, ticks = 0, reads = 0;
+	for (;;) {
+		bool edge = lt_rd(lt.gpio, LT_GPIO_INTR_STATUS(LT_IRQ)) & 1u;
+		if (edge) {
+			lt_wr(lt.gpio, LT_GPIO_INTR_STATUS(LT_IRQ), 0);
+		}
+		if (edge || lt.active || (++ticks % 10u) == 0) {
+			error = lt_poll_report();
+			reads++;
+			if (error) {
+				if ((errors++ % 100u) == 0) {
+					printf("LAKE TOUCH: report error %d (bus %#x qup %#x)\n", error,
+					    lt.bus_err, lt.qup_err);
+				}
+				if (errors == 10) {
+					lt_report(0);   /* release after persistent bad reads */
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		if (ticks == 6000u) {
+			printf("LAKE TOUCH: %u reads in the first minute\n", reads);
+		}
+		lt_sleep_ms(10);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (lt.started) {
+		return;
+	}
+	lt.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("LAKE TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	if (kernel_thread_start(touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* SWEET_LAKE */
 #endif /* ARM64_BOARD_CONFIG_SWEET */
