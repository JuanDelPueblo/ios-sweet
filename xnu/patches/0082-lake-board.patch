+/*
+ * lakelog (SWEET.h): "LAKELOG1" | u32 boots | u32 len | u64 pad | text.
+ * The boot shim starts it and XNU appends to it, through the same VA=PA
+ * and then alias mappings as the early console. They are Normal-NC, so the
+ * text reaches DRAM without cache maintenance and survives the reset into
+ * fastboot; tools/lake-log.py reads it back from Linux.
+ */
+struct lakelog_header {
+	char magic[8];
+	uint32_t boots, len;
+	uint64_t pad;
+};
+#define LAKELOG_CAP ((uint32_t)(SWEET_LAKELOG_SIZE - sizeof(struct lakelog_header)))
+
+static volatile struct lakelog_header *lake_log =
+    (volatile struct lakelog_header *)(uintptr_t)SWEET_LAKELOG_PHYS;
+static uint32_t lake_log_state;         /* 0 unchecked, 1 checking, 2 on */
+static uint32_t lake_log_len;
+
+void
+sweet_lakelog_append(const char *c, int size)
+{
+	static const char magic[8] = { 'L', 'A', 'K', 'E', 'L', 'O', 'G', '1' };
+	uint32_t state = os_atomic_load(&lake_log_state, acquire);
+
+	if (state == 0 && os_atomic_cmpxchg(&lake_log_state, 0, 1, acquire)) {
+		bool ok = true;
+		for (int i = 0; i < 8; i++) {
+			ok &= lake_log->magic[i] == magic[i];
+		}
+		if (!ok) {      /* booted without the shim's log: start one */
+			for (int i = 0; i < 8; i++) {
+				lake_log->magic[i] = magic[i];
+			}
+			lake_log->boots = 1;
+			lake_log->len = 0;
+		}
+		lake_log_len = MIN(lake_log->len, LAKELOG_CAP);
+		os_atomic_store(&lake_log_state, 2, release);
+		state = 2;
+	}
+	if (state != 2 || size <= 0) {
+		return;
+	}
+	uint32_t at = os_atomic_add_orig(&lake_log_len, (uint32_t)size, relaxed);
+	volatile char *text = (volatile char *)(lake_log + 1);
+	for (int i = 0; i < size && at + (uint32_t)i < LAKELOG_CAP; i++) {
+		text[at + (uint32_t)i] = c[i];
+	}
+	uint32_t end = MIN(at + (uint32_t)size, LAKELOG_CAP);
+	if (end > lake_log->len) {
+		lake_log->len = end;
+	}
+}
+
+/*
+ * The only way back to the host is a reset: the boot shim already set the
+ * PM660 PON reboot reason to "bootloader", so PSCI SYSTEM_RESET lands in
+ * fastboot. A panic first waits lakepanicwait seconds (default 20) so the
+ * screen can be read.
+ */
+void
+sweet_lake_reset(bool panicking)
+{
+	static uint32_t resetting;
+	uint32_t wait_s = 20;
+
+	if (os_atomic_xchg(&resetting, 1, relaxed)) {
+		for (;;) {
+			__builtin_arm_wfe();
+		}
+	}
+	if (panicking) {
+		PE_parse_boot_argn("lakepanicwait", &wait_s, sizeof(wait_s));
+		uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+		__builtin_arm_isb(ISB_SY);
+		uint64_t end = __builtin_arm_rsr64("CNTPCT_EL0") + freq * wait_s;
+		while (__builtin_arm_rsr64("CNTPCT_EL0") < end) {
+			__builtin_arm_isb(ISB_SY);
+		}
+	}
+	static const char msg[] = "\nSWEET LAKE: PSCI SYSTEM_RESET (to fastboot)\n";
+	sweet_lakelog_append(msg, sizeof(msg) - 1);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	register uint64_t x0 __asm__("x0") = 0x84000009;        /* PSCI SYSTEM_RESET */
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	for (;;) {
+		__builtin_arm_wfe();
+	}
+}
