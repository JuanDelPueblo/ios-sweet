@@ -132,8 +132,11 @@ sweet_lake_wdt_init(void)
  * context): it shows whether timer interrupts still arrive after the last
  * console line.
  */
+extern int snprintf(char *, size_t, const char *, ...) __printflike(3, 4);
+
+/* pc/lr: where the timer interrupt found the CPU (symbolize offline). */
 void
-sweet_lake_wdt_pet(void)
+sweet_lake_wdt_pet(uint64_t pc, uint64_t lr)
 {
 	static uint64_t next_beat;
 	uint64_t now = mach_absolute_time();
@@ -142,14 +145,12 @@ sweet_lake_wdt_pet(void)
 		*lake_wdt_rst = 1;
 	}
 	if (now >= next_beat) {
-		uint64_t s = now / 19200000ULL;
-		char line[] = "LAKE beat 0000s cpuN\n";
-		line[10] = (char)('0' + (s / 1000) % 10);
-		line[11] = (char)('0' + (s / 100) % 10);
-		line[12] = (char)('0' + (s / 10) % 10);
-		line[13] = (char)('0' + s % 10);
-		line[18] = (char)('0' + (__builtin_arm_rsr64("MPIDR_EL1") & 0xf));
-		sweet_lakelog_append(line, (int)sizeof(line) - 1);
+		char line[96];
+		int n = snprintf(line, sizeof(line), "LAKE beat %llus cpu%llu pc 0x%llx lr 0x%llx\n",
+		    now / 19200000ULL, __builtin_arm_rsr64("MPIDR_EL1") & 0xf, pc, lr);
+		if (n > 0) {
+			sweet_lakelog_append(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+		}
 		next_beat = now + 5 * 19200000ULL;
 	}
 }
