diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a148608..d9576d4 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -12,11 +12,14 @@
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>     /* SWEET_LAKE */
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
 void sweet_keys_init(void);
 
+#if !SWEET_LAKE
+
 #define KEYS_CORE_PA     0x0c440000u
 #define KEYS_OBS_PA      0x0e600000u
 #define KEYS_CNFG_PA     0x0c40a000u
@@ -179,4 +182,146 @@ sweet_keys_init(void)
 		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
 	}
 }
+#else /* SWEET_LAKE */
+/*
+ * lake: power and volume-down are the PM660 PON (SID 0) KPDPWR and RESIN
+ * real-time status bits, volume-up is PM660L (SID 2) GPIO 7, active low.
+ * Polled every 20 ms through the SDM660 SPMI PMIC arbiter v3 observer
+ * channels (EE 0), as the boot shim's spmi.c reads the PON. Read only: the
+ * only MMIO writes are EXT_READL commands.
+ */
+#define LK_CORE_PA      0x0800f000u     /* APID map at +0x800 */
+#define LK_OBS_PA       0x09400000u     /* observer channels, 0x8000 per APID */
+#define LK_APIDS        512u
+#define LK_PON_PPID     0x008u          /* SID 0, peripheral 0x08 */
+#define LK_PON_RT       0x0810u         /* bit 0 KPDPWR, bit 1 RESIN */
+#define LK_VUP_PPID     0x2c6u          /* SID 2, peripheral 0xc6 = GPIO 7 */
+#define LK_VUP_RT       0xc610u         /* bit 0 input level */
+
+static vm_offset_t lk_core, lk_pon, lk_vup;
+static uint32_t lk_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static uint32_t
+lk_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* The observer channel of the peripheral ppid (sid << 8 | peripheral), or 0. */
+static vm_offset_t
+lk_channel(uint16_t ppid)
+{
+	for (uint32_t n = 0; n < LK_APIDS; n++) {
+		uint32_t map = lk_rd(lk_core, 0x800u + 4u * n);
+		if (map != 0 && ((map >> 8) & 0xfffu) == ppid) {
+			return ml_io_map(LK_OBS_PA + 0x8000u * n, 0x1000);
+		}
+	}
+	return 0;
+}
+
+static bool
+lk_read(vm_offset_t ch, uint16_t addr, uint8_t *out)
+{
+	if (!ch) {
+		return false;
+	}
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)ch = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);  /* EXT_READL, 1 byte */
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		lk_last_status = lk_rd(ch, 0x08u);
+		if (lk_last_status & 1u) {
+			if (lk_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)lk_rd(ch, 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = { 0, 0, 0 };
+	unsigned errors = 0, logged = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, vup = 1;
+		bool pok = lk_read(lk_pon, LK_PON_RT, &pon);
+		bool vok = lk_read(lk_vup, LK_VUP_RT, &vup);
+		/* sweet_hid_key: 0 power, 1 volume up, 2 volume down */
+		int now[3] = { !!(pon & 1u), !(vup & 1u), !!(pon & 2u) };
+		bool ok[3] = { pok, vok, pok };
+		if (!pok || !vok) {
+			if ((errors++ % 250u) == 0) {
+				printf("LAKE KEYS: read error pon-ok=%d vup-ok=%d arb-status=%#x\n",
+				    pok, vok, lk_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; ++k) {
+			if (ok[k] && now[k] != state[k]) {
+				state[k] = now[k];
+				if (logged < 200) {
+					logged++;
+					printf("LAKE KEYS: key %d %s (pon %#x vup %#x)\n", k,
+					    state[k] ? "down" : "up", pon, vup);
+				}
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("LAKE KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	lk_core = ml_io_map(LK_CORE_PA, 0x1000);
+	if (!lk_core) {
+		printf("LAKE KEYS: MMIO mapping failed\n");
+		return;
+	}
+	lk_pon = lk_channel(LK_PON_PPID);
+	lk_vup = lk_channel(LK_VUP_PPID);
+	uint8_t pon = 0, vup = 0;
+	bool pok = lk_read(lk_pon, LK_PON_RT, &pon);
+	bool vok = lk_read(lk_vup, LK_VUP_RT, &vup);
+	printf("LAKE KEYS: PM660 PON %s rt %#x/%d, PM660L GPIO7 %s rt %#x/%d\n",
+	    lk_pon ? "found" : "missing", pon, pok, lk_vup ? "found" : "missing", vup, vok);
+	if (kernel_thread_start(keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* SWEET_LAKE */
 #endif /* ARM64_BOARD_CONFIG_SWEET */
