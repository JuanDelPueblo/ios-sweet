diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index fc99046..a26a57c 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -127,12 +127,31 @@ sweet_lake_wdt_init(void)
 	printf("SWEET LAKE: watchdog petted from the timer interrupt for %u s\n", max_s);
 }
 
+/*
+ * Also a heartbeat in the lakelog every 5 s (straight into the log, any
+ * context): it shows whether timer interrupts still arrive after the last
+ * console line.
+ */
 void
 sweet_lake_wdt_pet(void)
 {
-	if (lake_wdt_rst != NULL && mach_absolute_time() < lake_wdt_until) {
+	static uint64_t next_beat;
+	uint64_t now = mach_absolute_time();
+
+	if (lake_wdt_rst != NULL && now < lake_wdt_until) {
 		*lake_wdt_rst = 1;
 	}
+	if (now >= next_beat) {
+		uint64_t s = now / 19200000ULL;
+		char line[] = "LAKE beat 0000s cpuN\n";
+		line[10] = (char)('0' + (s / 1000) % 10);
+		line[11] = (char)('0' + (s / 100) % 10);
+		line[12] = (char)('0' + (s / 10) % 10);
+		line[13] = (char)('0' + s % 10);
+		line[18] = (char)('0' + (__builtin_arm_rsr64("MPIDR_EL1") & 0xf));
+		sweet_lakelog_append(line, (int)sizeof(line) - 1);
+		next_beat = now + 5 * 19200000ULL;
+	}
 }
 
