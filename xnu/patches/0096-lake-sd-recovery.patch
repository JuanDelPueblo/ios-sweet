+static uint32_t sd_rca;
+static int sd_identify(int attempt);
+
+/*
+ * After a failed transfer the card may still be sending or receiving
+ * (a multi-block transfer only stops with CMD12): stop it, check that it
+ * is back in the transfer state (CMD13), else identify it from scratch.
+ * Without this one timeout left every later command unanswered.
+ */
+static int
+sd_recover(void)
+{
+	uint32_t r[4] = { 0 };
+
+	sd_reset_lines();
+	(void)sd_cmd_once(12, 0, R_48_BUSY, 0, r);      /* fails if already stopped */
+	r[0] = 0;
+	if (sd_cmd_once(13, sd_rca << 16, R_48, 0, r) == 0 && ((r[0] >> 9) & 0xfu) == 4) {
+		return 0;
+	}
+	printf("LAKE SD: card not in transfer state (status 0x%x), identifying it again\n", r[0]);
+	return sd_identify(9);
+}
+
+/* sd_xfer_once, recovering the card and retrying up to three times. */
+static int
+sd_xfer(uint64_t sector, uint32_t nsect, bool write)
+{
+	static unsigned reported;
+	int error = sd_xfer_once(sector, nsect, write);
+
+	for (int i = 0; error && error != EINVAL && i < 3; i++) {
+		int rerr = sd_recover();
+		if (!rerr) {
+			error = sd_xfer_once(sector, nsect, write);
+		}
+		if (reported < 100) {
+			reported++;
+			printf("LAKE SD: %s of %u sectors at 0x%llx: retry %d -> %d (recover %d)\n",
+			    write ? "write" : "read", nsect, sector, i + 1, error, rerr);
+		}
+	}
+	return error;
+}
