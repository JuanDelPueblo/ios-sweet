+/*
+ * Wait for any of mask in the interrupt status (errors always end the wait):
+ * the status, or 0 on timeout. One CPU under load can preempt this thread
+ * past the deadline, so the status is read again before declaring a timeout.
+ */
+static uint32_t
+sd_wait_int(uint32_t mask, uint64_t us)
+{
+	uint64_t end = sd_deadline(us);
+	uint32_t st;
+	while (!((st = *(volatile uint32_t *)(su.regs + SDHCI_INT)) & (mask | INT_ERR))) {
+		if (mach_absolute_time() > end) {
+			st = *(volatile uint32_t *)(su.regs + SDHCI_INT);
+			return (st & (mask | INT_ERR)) ? st : 0;
+		}
+	}
+	return st;
+}
